# Tech Atlas production environment.
# Do not edit this template for a deployment: run ./init.sh, which copies it to .env and
# replaces every "__GENERATE__" with a fresh random secret. Then adjust .env if needed.

# --- Stack ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME="tech-atlas"
# The stack is split over these files; remove compose.auth.yml to bring your own identity
# provider (then also set OAUTH_ISSUER / OAUTH_JWKS below).
COMPOSE_FILE="docker-compose.yml:compose.traefik.yml:compose.auth.yml"
# Image tag of the app images. "stable" always points at the newest release
# (see create_release.py); set an exact version such as "2026.11.0" to pin or roll back.
VERSION="stable"

# --- Routing ---------------------------------------------------------------------------
# Hosts Traefik routes on. DNS for all of them must point at this server (via Cloudflare).
DASHBOARD_HOST="tech-atlas.at"
ADMIN_HOST="admin.tech-atlas.at"
AUTH_HOST="auth.tech-atlas.at"
# Port Cloudflare connects to on this server. Without a Cloudflare Origin Rule it has to be
# one of the HTTPS ports Cloudflare proxies: 443, 2053, 2083, 2087, 2096 or 8443.
HTTPS_PORT="443"

# --- MongoDB ---------------------------------------------------------------------------
# Users are created by init-mongo.js on the first start only; changing a password here
# afterwards does not change it in the database.
DB_ROOT_USERNAME="root"
DB_ROOT_PASSWORD="__GENERATE__"
DB_PIPE_DATABASE="pipelines"
DB_PIPE_USER_RW="pipe_rw"
DB_PIPE_PASS_RW="__GENERATE__"
DB_CACHE_DATABASE="cache"
DB_CACHE_USER_RW="cache_rw"
DB_CACHE_PASS_RW="__GENERATE__"
DB_REGISTRY_NAME="registries"
DB_REGISTRY_USER="registry_rw"
DB_REGISTRY_PASS="__GENERATE__"
DB_RAW_DATABASE="raw_data"
DB_RAW_RW_USER="raw_data_rw"
DB_RAW_RW_PASS="__GENERATE__"
DB_FE_DATABASE="frontend_data"
DB_FE_RW_USER="fe_data_rw"
DB_FE_RW_PASS="__GENERATE__"
DB_FE_R_USER="fe_data_r"
DB_FE_R_PASS="__GENERATE__"

# --- Login (OIDC) ------------------------------------------------------------------------
# Public client id, not a secret. It is compiled into the admin-ui image, so it has to stay
# in sync with admin-ui's environment.prod.ts.
OAUTH_CLIENT_ID="NjrD7i3pcLYKUPRlzdCpqLJGlbUwCq2DPY9ceeIh"
# Derived from AUTH_HOST by default; only set these for an external identity provider.
# OAUTH_ISSUER="https://auth.tech-atlas.at/application/o/tech-atlas/"
# OAUTH_JWKS="jwks/"

# --- authentik ---------------------------------------------------------------------------
# Never change the secret key after the first start: it invalidates all sessions.
AUTHENTIK_SECRET_KEY="__GENERATE__"
AUTHENTIK_DB_PASSWORD="__GENERATE__"
# Initial password of the "akadmin" user; only read on the first start.
AUTHENTIK_BOOTSTRAP_PASSWORD="__GENERATE__"
AUTHENTIK_BOOTSTRAP_EMAIL="admin@tech-atlas.at"
